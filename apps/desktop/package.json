{
  "name": "desktop",
  "version": "0.1.0",
  "description": "Interface desktop (Tauri v2 + SvelteKit 3) do KeyHybrid",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:server": "cd ../server && go build -tags no_ui -trimpath -buildvcs=false -ldflags=\"-s -w\" -o keyhybrid-server.exe .",
    "build:server:unix": "cd ../server && go build -tags no_ui -trimpath -buildvcs=false -ldflags=\"-s -w\" -o keyhybrid-server .",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
