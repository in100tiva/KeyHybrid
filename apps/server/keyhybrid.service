[Unit]
Description=KeyHybrid Gateway (cofre de chaves em 127.0.0.1:8090)

[Service]
ExecStart=%h/.keyhybrid/bin/keyhybrid-server serve --http=127.0.0.1:8090
Restart=on-failure
RestartSec=2
# sem core dump: o core levaria as chaves da memória e do ambiente
LimitCORE=0
# Endurecimento que vale em unidade de usuário (sem namespace, sem privilégio)
NoNewPrivileges=yes
UMask=0077
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
